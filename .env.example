NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Postgres variables supplied by the Vercel Supabase integration.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Optional local-only credentials used by `npm run supabase:setup-dev-users`.
# If omitted, the setup script generates passwords and prints them once.
BASALT_DEV_ADMIN_EMAIL=admin@basalt.local
BASALT_DEV_ADMIN_PASSWORD=
BASALT_DEV_ANALYST_EMAIL=analyst@basalt.local
BASALT_DEV_ANALYST_PASSWORD=
BASALT_DEV_CLUB_ADMIN_EMAIL=club-admin@northcoast.local
BASALT_DEV_CLUB_ADMIN_PASSWORD=
BASALT_DEV_CLUB_USER_EMAIL=course-manager@northcoast.local
BASALT_DEV_CLUB_USER_PASSWORD=
BASALT_DEV_COMMITTEE_EMAIL=committee@northcoast.local
BASALT_DEV_COMMITTEE_PASSWORD=
BASALT_DEV_OTHER_CLUB_EMAIL=manager@harbourdunes.local
BASALT_DEV_OTHER_CLUB_PASSWORD=
